                .blog-content-renderer { color: #405057; line-height: 1.8; font-size: 1.05rem; word-wrap: break-word; overflow-wrap: break-word; white-space: pre-wrap; }
                .blog-content-renderer p, .blog-content-renderer div, .blog-content-renderer h1, .blog-content-renderer h2, .blog-content-renderer h3, .blog-content-renderer h4, .blog-content-renderer h5, .blog-content-renderer h6, .blog-content-renderer li { white-space: normal; }
                .blog-content-renderer p, .blog-content-renderer div { margin-top: 0; margin-bottom: 1.25rem; display: block; }
                .blog-content-renderer h1 { font-size: 2.25em; font-weight: 800; margin: 1.5rem 0 0.75rem; color: #07243a; line-height: 1.2; display: block; }
                .blog-content-renderer h2 { font-size: 1.75em; font-weight: 700; margin: 1.5rem 0 0.75rem; color: #07243a; line-height: 1.3; display: block; }
