                .blog-content-renderer em, .blog-content-renderer i { font-style: italic; }
                .blog-content-renderer u { text-decoration: underline; }
                .blog-content-renderer img { max-width: 100%; height: auto; border-radius: 0.5rem; margin: 1.5rem 0; display: block; }
                .blog-content-renderer font[size="1"] { font-size: 0.75rem !important; }
