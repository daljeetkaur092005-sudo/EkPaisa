          * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
          }
          
          .linktree-body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1a1f3a 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            color: #e2e8f0;
            padding: 1rem;
          }

          /* Premium glassmorphism card with backdrop blur and gradient border */
          .card-container {
            position: relative;
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(16, 185, 129, 0.2);
            border-radius: 24px;
            backdrop-filter: blur(12px);
            box-shadow: 
              0 25px 50px -12px rgba(0, 0, 0, 0.5),
              inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
            overflow: hidden;
            animation: fadeInUp 0.8s ease-out;
            width: 100%;
            max-width: 340px;
            margin: 0 auto;
            padding: 1.5rem 1rem;
            margin-top: 1rem;
          }

          /* Subtle animated gradient border effect */
          .card-container::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), transparent);
            opacity: 0;
            animation: gradientBorder 3s ease-in-out infinite;
            border-radius: 24px;
            pointer-events: none;
          }

          /* Premium entrance animation */
          @keyframes fadeInUp {
            from {
              opacity: 0;
              transform: translateY(20px);
            }
            to {
              opacity: 1;
              transform: translateY(0);
            }
          }

          @keyframes gradientBorder {
            0%, 100% { opacity: 0; }
            50% { opacity: 1; }
          }

          /* Staggered link animation */
          .link-item {
            animation: slideIn 0.6s ease-out backwards;
            width: 100%;
          }

          .link-item:nth-child(1) { animation-delay: 0.1s; }
          .link-item:nth-child(2) { animation-delay: 0.2s; }
          .link-item:nth-child(3) { animation-delay: 0.3s; }
          .link-item:nth-child(4) { animation-delay: 0.4s; }
          .link-item:nth-child(5) { animation-delay: 0.5s; }

          @keyframes slideIn {
            from {
              opacity: 0;
              transform: translateX(-20px);
            }
            to {
              opacity: 1;
              transform: translateX(0);
            }
          }

          /* Professional icon container with gradient backgrounds */
          .icon-container {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            flex-shrink: 0;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
          }

          .icon-container svg {
            width: 18px;
            height: 18px;
            display: block;
          }

          /* Enhanced hover effect with scale and shadow */
          .link-item a:hover .icon-container {
            transform: scale(1.12) rotate(2deg);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
          }

          /* Premium link styling with smooth transitions */
          .link-item a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid rgba(148, 163, 184, 0.2);
            background: rgba(30, 41, 59, 0.4);
            text-decoration: none;
            color: #e2e8f0;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
            overflow: hidden;
            width: 100%;
          }

          /* Animated gradient background on hover */
          .link-item a::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05));
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
          }

          .link-item a:hover::before {
            opacity: 1;
          }

          .link-item a:hover {
            border-color: rgba(16, 185, 129, 0.4);
            background: rgba(30, 41, 59, 0.7);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(16, 185, 129, 0.2);
            transform: translateY(-2px);
          }

          .link-text {
            font-weight: 500;
            font-size: 13px;
            letter-spacing: -0.3px;
            position: relative;
            z-index: 1;
            flex-grow: 1;
          }

          /* Animated arrow indicator */
          .arrow-icon {
            opacity: 0;
            transform: translateX(-8px);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            flex-shrink: 0;
          }

          .link-item a:hover .arrow-icon {
            opacity: 1;
            transform: translateX(4px);
          }

          /* Premium logo with animated ring */
          .logo-container {
            position: relative;
            animation: float 3s ease-in-out infinite;
            margin-top: 1rem;
            margin-bottom: 0.75rem;
            display: flex;
            justify-content: center;
            align-items: center;
          }

          .logo-container img {
            width: 72px;
            height: 72px;
            border-radius: 18px;
            object-fit: contain;
            background: transparent;
            border: 2px solid rgba(16, 185, 129, 0.3);
            box-shadow: 0 20px 40px rgba(16, 185, 129, 0.2);
            padding: 8px;
          }

          .logo-container::after {
            content: '';
            position: absolute;
            inset: -6px;
            border-radius: 18px;
            border: 2px solid rgba(16, 185, 129, 0.2);
            animation: pulse 2s ease-in-out infinite;
            pointer-events: none;
          }

          @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
          }

          @keyframes pulse {
            0%, 100% {
              border-color: rgba(16, 185, 129, 0.2);
              box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
            }
            50% {
              border-color: rgba(16, 185, 129, 0.4);
              box-shadow: 0 0 0 8px rgba(16, 185, 129, 0.1);
            }
          }

          /* Premium heading styles */
          .brand-name {
            font-family: 'Geist', sans-serif;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: fadeInDown 0.8s ease-out;
            margin-bottom: 0.25rem;
            margin-top: 0.5rem;
          }

          .tagline {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 1.5rem;
            font-weight: 400;
          }

          @keyframes fadeInDown {
            from {
              opacity: 0;
              transform: translateY(-10px);
            }
            to {
              opacity: 1;
              transform: translateY(0);
            }
          }

          /* Premium footer */
          .footer-text {
            font-size: 11px;
            letter-spacing: 0.5px;
            color: rgba(148, 163, 184, 0.6);
            text-transform: uppercase;
            font-weight: 600;
            margin-top: 16px;
            padding-top: 12px;
            border-top: 1px solid rgba(16, 185, 129, 0.1);
            transition: color 0.3s ease;
            line-height: 1.5;
          }

          /* Navigation spacing */
          .nav-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
          }

          /* Content wrapper for better alignment */
          .content-wrapper {
            width: 100%;
            max-width: 280px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
          }

          /* Header section with proper spacing */
          .header-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            margin-bottom: 1.5rem;
          }

          /* Mobile optimization */
          @media (max-width: 640px) {
            .card-container {
              border-radius: 20px;
              max-width: 92vw;
              padding: 1.25rem 1rem;
              margin-top: 0.5rem;
            }

            .brand-name {
              font-size: 20px;
            }

            .link-item a {
              padding: 10px 12px;
              border-radius: 10px;
            }

            .icon-container {
              width: 32px;
              height: 32px;
            }

            .icon-container svg {
              width: 16px;
              height: 16px;
            }

            .logo-container img {
              width: 64px;
              height: 64px;
            }

            .content-wrapper {
              max-width: 100%;
            }

            .logo-container {
              margin-top: 0.75rem;
              margin-bottom: 0.5rem;
            }
          }

          @media (max-width: 380px) {
            .card-container {
              padding: 1rem 0.75rem;
              margin-top: 0.25rem;
            }
            
            .brand-name {
              font-size: 18px;
            }
            
            .tagline {
              font-size: 11px;
            }
            
            .link-text {
              font-size: 12px;
            }
            
            .logo-container {
              margin-top: 0.5rem;
              margin-bottom: 0.25rem;
            }
          }
