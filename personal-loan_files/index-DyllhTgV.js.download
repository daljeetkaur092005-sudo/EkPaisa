        * {
          -webkit-tap-highlight-color: transparent;
        }

        html {
          scroll-behavior: smooth;
        }

        @media (prefers-reduced-motion: reduce) {
          .transition-all,
          .transition-transform,
          .transition-colors,
          .transition-opacity,
          button,
          select,
          input {
            transition: none !important;
            animation: none !important;
          }
          html { scroll-behavior: auto; }
        }

        @supports (-webkit-touch-callout: none) {
          nav[class*="fixed bottom-0"] {
            padding-bottom: env(safe-area-inset-bottom);
          }
          header.fixed {
            padding-top: env(safe-area-inset-top);
          }
        }

        body.mobile-menu-open {
          overflow: hidden !important;
          position: fixed;
          width: 100%;
          height: 100%;
        }

        #mobile-menu div[class*="overflow-y-auto"]::-webkit-scrollbar { width: 4px; }
        #mobile-menu div[class*="overflow-y-auto"]::-webkit-scrollbar-track { background: transparent; }
        #mobile-menu div[class*="overflow-y-auto"]::-webkit-scrollbar-thumb {
          background: #d1d5db;
          border-radius: 2px;
        }

        @keyframes slideUp {
          from { transform: translateY(100%); }
          to { transform: translateY(0); }
        }

        #mobile-menu {
          animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        #mobile-menu div[class*="overflow-y-auto"] {
          -webkit-overflow-scrolling: touch;
          scroll-behavior: smooth;
        }

        @media (max-width: 767px) {
          body { padding-bottom: 56px; } /* Adjusted for slimmer bottom nav */
          body.mobile-menu-open { padding-bottom: 0; }
        }
