          @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Roboto:wght@400;500;700&display=swap');
          
          @keyframes tokenMoveUp {
            0% { transform: translateY(0); opacity: 0; }
            50% { transform: translateY(-14px); opacity: 1; }
            100% { transform: translateY(0); opacity: 1; }
          }
          
          @keyframes fade-in-up {
            0% { opacity: 0; transform: translate3d(0, 30px, 0); }
            100% { opacity: 1; transform: translate3d(0, 0, 0); }
          }
          
          .animate-token-1 { animation: tokenMoveUp 0.6s ease forwards; animation-delay: 0.1s; }
          .animate-token-2 { animation: tokenMoveUp 0.6s ease forwards; animation-delay: 0.2s; }
          .animate-token-3 { animation: tokenMoveUp 0.6s ease forwards; animation-delay: 0.3s; }

          .animate-fade-in-up { animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; will-change: transform, opacity; }
          .delay-100 { animation-delay: 100ms; }
          .delay-200 { animation-delay: 200ms; }
          .delay-300 { animation-delay: 300ms; }
          
          .hide-scrollbar::-webkit-scrollbar { display: none; }
          .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

          .bidding-card {
            position: absolute;
            top: 0;
            left: 0;
            background: #0f172a;
            color: #fff;
            border-radius: 22px;
            display: flex;
            align-items: center;
            overflow: visible;
            will-change: transform, width, height, opacity;
            transform-style: preserve-3d;
            backface-visibility: hidden;
            font-family: 'Montserrat', sans-serif;
          }
          .bidding-badge {
            position: absolute;
            background: #84cc16;
            color: #fff;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            border-radius: 7px;
            pointer-events: none;
            white-space: nowrap;
            transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
            opacity: 0;
            transform: translateY(6px) scale(0.9);
            font-family: 'Montserrat', sans-serif;
          }
          .bidding-badge.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
          }
          .c-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
            overflow: hidden;
          }
          .c-num {
            font-weight: 800;
            color: rgba(255,255,255,0.35);
            min-width: 24px;
            flex-shrink: 0;
            font-variant-numeric: tabular-nums;
          }
          .c-name {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          }
          .c-roi {
            font-weight: 900;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
            flex-shrink: 0;
            letter-spacing: -0.3px;
          }
          .status-dot {
            animation: pulse-dot 1.8s ease-in-out infinite;
          }
          @keyframes pulse-dot {
            0%,100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.5); }
            50% { box-shadow: 0 0 0 6px rgba(34,197,94,0); }
          }
          .log-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: clamp(10px, 2.5vw, 11.5px);
            font-family: 'Courier New', monospace;
            font-weight: 600;
            color: #64748b;
            opacity: 0;
            transform: translateY(-4px);
            transition: opacity 0.28s ease, transform 0.28s ease;
          }
          .log-row.show { opacity: 1; transform: translateY(0); }
          .log-row .lbank { color: #0f172a; font-weight: 800; }
