              .blog-content-renderer { 
                color: #374151 !important; 
                line-height: 1.85 !important; 
                font-size: 1.125rem !important; 
                word-break: break-word !important;
                overflow-wrap: break-word !important;
                /* Forces raw Enters to separate text into paragraphs natively */
                white-space: pre-wrap !important; 
                display: block !important;
                width: 100% !important;
              }
              
              /* Resets inner blocks so they function as normal HTML */
              .blog-content-renderer p, .blog-content-renderer div { 
                display: block !important; 
                margin-bottom: 1.5em !important; 
                margin-top: 0 !important; 
                white-space: pre-wrap !important; 
                min-height: 1.5rem !important; 
              }
              
              .blog-content-renderer span { display: inline !important; }
              
              .blog-content-renderer h1 { font-size: 2.25em !important; font-weight: 800 !important; margin: 1.2em 0 0.6em !important; color: #07243a !important; line-height: 1.2 !important; display: block !important; white-space: normal !important; }
              .blog-content-renderer h2 { font-size: 1.75em !important; font-weight: 700 !important; margin: 1.2em 0 0.6em !important; color: #07243a !important; line-height: 1.3 !important; display: block !important; white-space: normal !important; }
              .blog-content-renderer h3 { font-size: 1.25em !important; font-weight: 600 !important; margin: 1.2em 0 0.6em !important; color: #07243a !important; line-height: 1.4 !important; display: block !important; white-space: normal !important; }
              
              .blog-content-renderer ul { list-style-type: disc !important; padding-left: 1.5em !important; margin-bottom: 1.2em !important; display: block !important; }
              .blog-content-renderer ol { list-style-type: decimal !important; padding-left: 1.5em !important; margin-bottom: 1.2em !important; display: block !important; }
              .blog-content-renderer li { margin-bottom: 0.4em !important; display: list-item !important; }
              
              .blog-content-renderer strong, .blog-content-renderer b { font-weight: 700 !important; color: #07243a !important; }
              .blog-content-renderer em, .blog-content-renderer i { font-style: italic !important; }
              .blog-content-renderer u { text-decoration: underline !important; }
              
              .blog-content-renderer a, .blog-content-renderer a * { color: #76b900 !important; font-weight: 600 !important; text-decoration: underline !important; cursor: pointer !important; }
              .blog-content-renderer a:hover { text-decoration: none !important; }
              
              /* Font Size Support */
              .blog-content-renderer font[size="1"] { font-size: 0.85rem !important; }
              .blog-content-renderer font[size="2"] { font-size: 0.95rem !important; }
              .blog-content-renderer font[size="3"] { font-size: 1.05rem !important; }
              .blog-content-renderer font[size="4"] { font-size: 1.15rem !important; }
              .blog-content-renderer font[size="5"] { font-size: 1.5rem !important; }
              .blog-content-renderer font[size="6"] { font-size: 1.75rem !important; }
              .blog-content-renderer font[size="7"] { font-size: 2rem !important; }
